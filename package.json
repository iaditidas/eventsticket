{
  "name": "event-ticketing-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/api run dev & npm --prefix apps/web run dev",
    "dev:frontend": "npm --prefix apps/web run dev",
    "dev:backend": "npm --prefix apps/api run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix packages/types run build && npm --prefix apps/web run build",
    "build:frontend": "npm --prefix apps/web run build",
    "build:backend": "npm --prefix apps/api run build",
    "build:api": "npm --prefix apps/api run build",
    "test": "npm --prefix apps/api test",
    "db:push": "npm --prefix apps/api run db:push",
    "db:seed": "npm --prefix apps/api run db:seed"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "next": "14.1.0",
    "typescript": "^5.3.3"
  }
}
